; dot-log — where a log record goes after DotLog emits it.
;
; The distributable is `addons/dot_log/`. This project exists so the addon can
; be opened and validated standalone.
;
; `addons/dot_core/` is a LOCAL SYMLINK to ../dot-core/addons/dot_core and is
; gitignored — dot-core is a separate repository. See CLAUDE.md.

config_version=5

[application]

config/name="dot-log"
config/description="The sink layer for DotLog: rotating files, an in-memory ring, syslog, a SQL table, and batched HTTP shipping to the log services in common use. Gating, redaction and batching happen once, in front of all of them."
config/version="0.1.0"
run/main_scene="res://examples/log_selftest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_core/plugin.cfg", "res://addons/dot_log/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
